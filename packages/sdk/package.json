{
  "name": "@darkseek/sdk",
  "version": "0.2.1",
  "description": "Read, build and verify everything the DarkSeek protocol does onchain",
  "license": "BUSL-1.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nibblescreative-afk/darkseek.git",
    "directory": "packages/sdk"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "darkseek-verify": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@solana/web3.js": "1.99.0"
  }
}
