{
  "name": "@darkseek/indexer",
  "version": "0.2.1",
  "private": true,
  "description": "Follows the DarkSeek vault program, stores its events and serves read only totals",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@darkseek/sdk": "0.2.1",
    "@solana/web3.js": "3.2.1"
  }
}
